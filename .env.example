# Copy to .env. Never commit real keys. .env is gitignored.
# The app reads .env on startup and does not override variables already set.

# Vision: set one. If both are set, OpenAI is used.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
GEMINI_VISION_MODEL=gemini-2.5-flash

# You.com (required for live source receipts)
YDC_API_KEY=
# Set to 1 to call the Research API (lite) instead of the faster Answer API.
YDC_USE_RESEARCH=0

# Treg reverse image. Needs a public image URL plus this key. Skipped otherwise.
TREG_API_KEY=
TREG_LENS_TOOL=serper.google.serp.lens

# XDC AI pay-per-verify. Both must be set before /api/x402/check returns 402.
# XDC_AI_KEY is the flag. XDC_PAYTO is the USDC recipient (your address).
XDC_AI_KEY=
XDC_PAYTO=
# 20000 base units = 0.02 USDC (6 decimals).
XDC_PRICE_BASE=20000

PROVENANCE_CACHE_DIR=cache
